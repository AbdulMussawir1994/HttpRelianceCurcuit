{
  "ProductApi": {
    "BaseUrl": "https://localhost:7296/",
    "TimeoutSeconds": 15
  },

  "ShippingApi": {
    "BaseUrl": "https://localhost:7297/",
    "TimeoutSeconds": 20,
    "QuotePathTemplate": "api/Shipping/GetQuote/{productId}"
  },

  "Resilience": {
    "RetryCount": 2,
    "RetryDelayMilliseconds": 250,
    "CircuitFailureRatio": 0.5,
    "CircuitMinimumThroughput": 5,
    "CircuitSamplingSeconds": 30,
    "CircuitBreakSeconds": 20,
    "AttemptTimeoutSeconds": 5
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
      //"Polly": "None",
      //"System.Net.Http.HttpClient": "None"
    }
  },

  "AllowedHosts": "*"
}
